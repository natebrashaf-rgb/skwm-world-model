# 飞书机器人 Webhook URL
# 1. 在飞书中创建群组
# 2. 群设置 → 群机器人 → 添加机器人 → 自定义机器人
# 3. 复制 Webhook URL 粘贴到下面（去掉 <>）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/<your_webhook_id>

# Neo4j 图数据库配置
# 1. 安装 Neo4j: https://neo4j.com/download/
# 2. 或使用 Docker: docker run -p 7687:7687 -p 7474:7474 -e NEO4J_AUTH=neo4j/password neo4j
# 3. 配置以下环境变量
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
